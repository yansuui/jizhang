<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The widget only reads the aggregate snapshot; it never owns a session or ledger access. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.yansuu1.jizhang.ios</string>
    </array>
</dict>
</plist>
