# ─────────────────────────────────────────────────────────────────────────────
# jizhang environment — copy to .env and adjust:  cp .env.example .env
#
# `.env` is gitignored. Docker Compose reads the root `.env` and passes it into
# the container via `env_file`. For local `pnpm dev`, copy this file to
# `packages/server/.env`; the server reads it from its package working directory.
#
# Vars marked REQUIRED have no default on purpose: the server validates the
# whole set at startup and exits 1 with an explicit list of problems instead of
# silently falling back (see packages/server/src/config.ts).
# ─────────────────────────────────────────────────────────────────────────────

# ── HTTP ─────────────────────────────────────────────────────────────────────
# Port the Fastify server binds inside the container. Compose maps it to
# 127.0.0.1:8081 on the host only.
PORT=8081
# Bind address. 0.0.0.0 is required inside a container (the host reverse proxy
# connects from outside the container network namespace).
HOST=0.0.0.0
# Trust X-Forwarded-* / X-Real-IP sent by the host Nginx/Caddy. Keep true behind
# the reverse proxy so client IPs and protocol are logged correctly.
TRUST_PROXY=true
# IANA timezone for bill dates and budget cycles. MUST match the user's calendar
# (China: Asia/Shanghai). UTC shifts China midnight to the previous day and
# mis-files salary into the prior budget cycle.
TZ=Asia/Shanghai

# ── Storage ──────────────────────────────────────────────────────────────────
# Directory holding jizhang.db. In Docker, compose forces /data (the mounted
# volume); the default below is what a local `pnpm dev` run should use.
DATA_DIR=./data
# The server exposes API routes only. No Web asset directory is used.

# Deployment-only Compose settings (not server configuration).
# Pin a tested image tag on the server; latest is only a local build default.
# JIZHANG_IMAGE=jizhang:api-2026-10-09
# For upgrades, inspect the old /data mount and use docker-compose.migration.yml.
# This MUST be the exact existing volume name, not a guessed project prefix.
# JIZHANG_DATA_VOLUME=existing-project_jizhang-data
# Existing bind mount: use docker-compose.bind.yml instead of migration.yml.
# JIZHANG_DATA_BIND=/existing/absolute/path
# Bridge-network Caddy only, used with docker-compose.caddy.yml.
# Current host-network caddy container uses loopback and needs no overlay:
# JIZHANG_CADDY_NETWORK=existing-caddy-network

# ── Runtime tuning ──────────────────────────────────────────────────────────
# Cap the V8 old-space heap so the container cannot trigger the host OOM killer.
# The Dockerfile bakes the same value in, so it usually needs no override.
# NODE_OPTIONS=--max-old-space-size=256
# pino level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ── Auth (REQUIRED — no defaults) ────────────────────────────────────────────
# Initial administrator / offline password-reset target. Existing ownership is immutable.
JIZHANG_USERNAME=admin
# ⚠️ REQUIRED TO BOOT, BUT **NOT USED TO LOG IN**.
#
# The server refuses to start without this variable, yet nothing reads its value:
# `config.passwordHash` is loaded and never consumed. The credential that actually
# authenticates you lives in central `auth.db` (`users.password_hash`). Initial
# administrator setup and offline account recovery use:
#
#   docker compose stop jizhang
#   docker compose run --rm jizhang node packages/server/dist/cli.js set-password
#   docker compose up -d jizhang
#
# That command needs an interactive terminal (it reads the password with echo off),
# so run it from a real terminal while every server/writer is stopped.
#
# Setting a *valid* argon2id hash here still will not let you log in: you would get
# `401 INVALID_CREDENTIALS` with the server log saying `reason:"no-user"`, because
# no row exists in central `auth.db` yet. Run `set-password` before the first `up`.
#
# The placeholder below is fine for booting; replace it only to satisfy scanners.
JIZHANG_PASSWORD_HASH=dev-placeholder-replace-with-argon2id-hash
# Session lifetime in days.
SESSION_TTL_DAYS=30

# ── AI assistant (optional) ──────────────────────────────────────────────────
# The settings page stores the provider configuration in SQLite. This separate
# 64-hex-character key encrypts the provider API key at rest; it is never stored
# in the database. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# AI remains disabled when this is absent; it becomes required when saving a secret.
# On upgrades, preserve the original key exactly or stored provider secrets cannot
# be decrypted. Never generate a replacement key for an existing database.
# JIZHANG_AI_ENCRYPTION_KEY=

# ── Item photo cutout (optional, private Docker service) ─────────────────────
# Disabled by default. To enable, set the URL AND start Compose with --profile cutout.
# Leave unset to keep ordinary photo upload without the optional inference worker.
# JIZHANG_ITEM_CUTOUT_SERVICE_URL=http://jizhang-cutout:8090
# JIZHANG_CUTOUT_IMAGE=jizhang-cutout:api-2026-10-09

# Optional build-only PyPI index for the private Python service. The Dockerfile
# defaults to official PyPI; set this in .env if a regional mirror is faster.
# PYTHON_PACKAGE_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
